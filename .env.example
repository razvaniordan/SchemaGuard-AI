APP_NAME=SchemeGuard AI
ENVIRONMENT=development
FRONTEND_PORT=3000
BACKEND_PORT=8000
DATABASE_URL=
OPENAI_API_KEY=

# ETL / Analytics configuration
# Number of rows to process in a single ETL batch
ETL_BATCH_SIZE=1000
# How far back (in hours) to include transactions when running incremental loads
ETL_INCREMENTAL_HOURS=24
# Logging for ETL: DEBUG, INFO, WARNING, ERROR
ETL_LOG_LEVEL=INFO
# Optional file to write ETL logs to (relative to repo root)
ETL_LOG_FILE=logs/etl.log